[Unit]
Description=LUDUS EDITS (mini-app + render worker)
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/opt/edits
EnvironmentFile=/opt/edits/.env
ExecStart=/opt/edits/venv/bin/uvicorn server.main:app --host 0.0.0.0 --port 8444 \
  --ssl-certfile /etc/letsencrypt/live/api.duddl.ru/fullchain.pem \
  --ssl-keyfile /etc/letsencrypt/live/api.duddl.ru/privkey.pem
Restart=always
RestartSec=5
# низкий приоритет: монтаж не должен тормозить ботов и рилсы
Nice=10
CPUWeight=20
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
